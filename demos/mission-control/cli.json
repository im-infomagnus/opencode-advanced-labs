{
  "$schema": "https://opencode.ai/v2/cli.json",
  "tabs": {
    "mode": "on",
    "scope": "cwd",
    "layout": "vertical",
    "indicators": "status"
  },
  "diffs": {
    "source": "branch",
    "tree": true,
    "view": "auto"
  },
  "attention": {
    "notifications": true,
    "sound": false
  }
}
